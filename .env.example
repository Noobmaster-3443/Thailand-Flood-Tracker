# =========================================================================
# Thailand Flood Tracker - Environment Variables Configuration
# =========================================================================

# All environment variables below are OPTIONAL.
# The application runs fully with open data APIs and verified static fallbacks without any keys.

# -------------------------------------------------------------------------
# SERVER-SIDE VARIABLES (Optional external API overrides)
# -------------------------------------------------------------------------

# GISTDA Disaster API Key & URL (Server-side Only)
# Optional: If provided, fetches live radar flood extent; otherwise uses verified GISTDA flood extent product.
GISTDA_API_KEY=
GISTDA_API_URL=https://disaster.gistda.or.th/api/v1/flood/extent

# Thai Meteorological Department (TMD) API Credentials (Server-side Only)
# Optional: UID and Key from https://data.tmd.go.th/ for severe weather warning feeds.
TMD_API_UID=
TMD_API_KEY=

# Department of Highways (DOH) API URL (Server-side Only)
# Optional: Custom machine-readable highway flood incident API endpoint if available.
DOH_API_URL=
